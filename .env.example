# Every VITE_* value is embedded in the browser build and is public.
# Presentation modes: web/self-service | hospital-kiosk | staffed-tablet.
VITE_DEPLOYMENT_MODE=web/self-service

# Documented kiosk defaults, in milliseconds. These are public timing values,
# not credentials; an operator must approve settings before a real deployment.
VITE_KIOSK_IDLE_WARNING_MS=240000
VITE_KIOSK_IDLE_RESET_MS=300000

# Leave both empty for a local-only walkthrough. For a configured backend, use
# only the project URL and a browser-safe PUBLISHABLE key in a local .env.local.
# Never put a service-role/secret key, database password, or staff credential in
# a VITE_* variable or this example file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
